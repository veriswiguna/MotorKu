<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:paddingBottom="40dp"
        android:gravity="center_horizontal">

        <!-- Rider Profile Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/bg_hud_card"
            android:padding="18dp"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <!-- Circle Avatar for Initials -->
            <TextView
                android:id="@+id/tvAvatarInitials"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:background="@drawable/bg_circle_avatar"
                android:gravity="center"
                android:text="MK"
                android:textColor="@color/bg_main"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_marginEnd="16dp"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvRiderName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Rider Name"
                    android:textColor="@color/text_bright"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="2dp"/>

                <TextView
                    android:id="@+id/tvRiderEmail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="rider@email.com"
                    android:textColor="@color/accent_cyan"
                    android:textSize="13sp"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:id="@+id/tvMotorSpecs"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Transmisi: Matic | Th: 2021 | Odo: 18.500 KM"
                    android:textColor="@color/text_muted"
                    android:textSize="12sp"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Dynamic Header Transmission Badge -->
        <TextView
            android:id="@+id/tvBadgeTransmisi"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🛵 TRANSMISI MATIC (CVT &amp; V-BELT)"
            android:textColor="@color/accent_cyan"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:background="@drawable/bg_pill_cyan"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            android:layout_marginBottom="16dp"/>

        <!-- Overall Health Index Score Card (Glowing Card) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_hud_card_glow"
            android:padding="24dp"
            android:gravity="center"
            android:layout_marginBottom="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/lbl_health_score"
                android:textColor="@color/text_muted"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.12"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/tvHealthScore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0%"
                android:textColor="@color/accent_cyan"
                android:textSize="56sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:id="@+id/tvStatusCategory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PERFORMA PRIMA"
                android:textColor="@color/accent_cyan"
                android:textSize="14sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginBottom="16dp"/>

            <ProgressBar
                android:id="@+id/pbHealthScore"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="14dp"
                android:max="100"
                android:progress="0"
                android:progressTint="@color/accent_cyan"
                android:progressBackgroundTint="@color/border_color"/>
        </LinearLayout>

        <!-- Komponen 1: Oli Mesin Synthetic -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_hud_card"
            android:padding="18dp"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="6dp">

                <TextView
                    android:id="@+id/tvTitleOli"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/lbl_oli_title"
                    android:textColor="@color/text_bright"
                    android:textSize="13sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/tvPersenOli"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0%"
                    android:textColor="@color/accent_cyan"
                    android:textSize="13sp"
                    android:textStyle="bold"/>
            </LinearLayout>

            <TextView
                android:id="@+id/tvStatusOli"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sisa: 0 KM"
                android:textColor="@color/text_muted"
                android:textSize="12sp"
                android:layout_marginBottom="10dp"/>

            <ProgressBar
                android:id="@+id/pbOli"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:max="100"
                android:progress="0"
                android:progressTint="@color/accent_cyan"
                android:progressBackgroundTint="@color/border_color"/>
        </LinearLayout>

        <!-- Komponen 2: Transmisi Dinamis (Roller CVT vs Rantai & Gear Kit) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_hud_card"
            android:padding="18dp"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="6dp">

                <TextView
                    android:id="@+id/tvTitleTransmisi"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/lbl_cvt_title"
                    android:textColor="@color/text_bright"
                    android:textSize="13sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/tvPersenTransmisi"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0%"
                    android:textColor="@color/accent_purple"
                    android:textSize="13sp"
                    android:textStyle="bold"/>
            </LinearLayout>

            <TextView
                android:id="@+id/tvStatusTransmisi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sisa: 0 KM"
                android:textColor="@color/text_muted"
                android:textSize="12sp"
                android:layout_marginBottom="10dp"/>

            <ProgressBar
                android:id="@+id/pbTransmisi"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:max="100"
                android:progress="0"
                android:progressTint="@color/accent_purple"
                android:progressBackgroundTint="@color/border_color"/>
        </LinearLayout>

        <!-- Komponen 3: Aki Motor Dry Cell -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_hud_card"
            android:padding="18dp"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="6dp">

                <TextView
                    android:id="@+id/tvTitleAki"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/lbl_aki_title"
                    android:textColor="@color/text_bright"
                    android:textSize="13sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/tvPersenAki"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0%"
                    android:textColor="@color/accent_cyan"
                    android:textSize="13sp"
                    android:textStyle="bold"/>
            </LinearLayout>

            <TextView
                android:id="@+id/tvStatusAki"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Kondisi Aki: 0%"
                android:textColor="@color/text_muted"
                android:textSize="12sp"
                android:layout_marginBottom="10dp"/>

            <ProgressBar
                android:id="@+id/pbAki"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:max="100"
                android:progress="0"
                android:progressTint="@color/accent_cyan"
                android:progressBackgroundTint="@color/border_color"/>
        </LinearLayout>

        <!-- Komponen 4: Filter Udara & Busi Pembakaran -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_hud_card"
            android:padding="18dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="6dp">

                <TextView
                    android:id="@+id/tvTitleFilter"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/lbl_filter_title"
                    android:textColor="@color/text_bright"
                    android:textSize="13sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/tvPersenFilter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0%"
                    android:textColor="@color/accent_yellow"
                    android:textSize="13sp"
                    android:textStyle="bold"/>
            </LinearLayout>

            <TextView
                android:id="@+id/tvStatusFilter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Status Busi &amp; Filter: Bersih (Normal)"
                android:textColor="@color/text_muted"
                android:textSize="12sp"
                android:layout_marginBottom="10dp"/>

            <ProgressBar
                android:id="@+id/pbFilter"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:max="100"
                android:progress="0"
                android:progressTint="@color/accent_yellow"
                android:progressBackgroundTint="@color/border_color"/>
        </LinearLayout>

        <!-- Itemized Cost Estimation Card (Rincian Biaya Servis Transparan) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_hud_card"
            android:padding="22dp"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/lbl_biaya_title"
                android:textColor="@color/accent_cyan"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:id="@+id/tvEstimasiBiaya"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rp 0"
                android:textColor="@color/accent_cyan"
                android:textSize="32sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/tvRincianBiaya"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="• Jasa Bengkel Dasar: Rp 50.000\n• Semua komponen dalam kondisi prima!"
                android:textColor="@color/text_muted"
                android:textSize="12sp"
                android:lineSpacingExtra="4dp"/>
        </LinearLayout>

        <!-- Button Kembali -->
        <Button
            android:id="@+id/btnKembali"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="@string/btn_kembali"
            android:textColor="@color/text_bright"
            app:backgroundTint="@color/card_bg"
            android:layout_marginBottom="12dp"/>

    </LinearLayout>
</ScrollView>
