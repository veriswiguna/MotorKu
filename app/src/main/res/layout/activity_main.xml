<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:paddingBottom="40dp"
        android:gravity="center_horizontal">

        <!-- Top Header HUD Pill -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/lbl_hud_tag"
            android:textColor="@color/accent_cyan"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.12"
            android:background="@drawable/bg_pill_cyan"
            android:paddingHorizontal="16dp"
            android:paddingVertical="6dp"
            android:layout_marginBottom="16dp"/>

        <!-- App Brand Header Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_hud_card"
            android:padding="24dp"
            android:gravity="center"
            android:layout_marginBottom="18dp">

            <ImageView
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:src="@drawable/ic_motorku_logo"
                android:contentDescription="@string/cd_logo"
                android:layout_marginBottom="12dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="@color/accent_cyan"
                android:textSize="28sp"
                android:textStyle="bold"
                android:letterSpacing="0.06"
                android:layout_marginBottom="2dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_tagline"
                android:textColor="@color/accent_cyan"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.06"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_subtitle"
                android:textColor="@color/text_muted"
                android:textSize="11sp"
                android:layout_marginBottom="14dp"/>

            <!-- Quick Autofill Demo Button -->
            <Button
                android:id="@+id/btnDemo"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="@string/btn_demo"
                android:textColor="@color/accent_cyan"
                android:textSize="12sp"
                android:textStyle="bold"
                app:backgroundTint="@color/input_bg"
                android:paddingHorizontal="20dp"/>
        </LinearLayout>

        <!-- Motor Transmission Type Selector -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_hud_card"
            android:padding="18dp"
            android:layout_marginBottom="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/lbl_transmisi"
                android:textColor="@color/accent_cyan"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="10dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnTypeMatic"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_chip_selected"
                    android:gravity="center"
                    android:text="@string/type_matic"
                    android:textColor="@color/accent_cyan"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:clickable="true"
                    android:focusable="true"/>

                <TextView
                    android:id="@+id/btnTypeManual"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_chip_unselected"
                    android:gravity="center"
                    android:text="@string/type_manual"
                    android:textColor="@color/text_muted"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:clickable="true"
                    android:focusable="true"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Form Card Container -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_hud_card"
            android:padding="20dp"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/form_title"
                android:textColor="@color/text_bright"
                android:textSize="14sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/form_subtitle"
                android:textColor="@color/text_muted"
                android:textSize="12sp"
                android:layout_marginBottom="18dp"/>

            <!-- 1. Nama Pemilik -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/lbl_nama"
                android:textColor="@color/accent_cyan"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp"/>

            <EditText
                android:id="@+id/etNamaPemilik"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_nama"
                android:textColorHint="@color/text_muted"
                android:textColor="@color/text_bright"
                android:inputType="textPersonName"
                android:autofillHints="name"
                android:padding="14dp"
                android:background="@drawable/bg_input_hud"
                android:layout_marginBottom="14dp"/>

            <!-- 2. Email Pemilik -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/lbl_email"
                android:textColor="@color/accent_cyan"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp"/>

            <EditText
                android:id="@+id/etEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_email"
                android:textColorHint="@color/text_muted"
                android:textColor="@color/text_bright"
                android:inputType="textEmailAddress"
                android:autofillHints="emailAddress"
                android:padding="14dp"
                android:background="@drawable/bg_input_hud"
                android:layout_marginBottom="14dp"/>

            <!-- 3. Tahun Motor -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/lbl_tahun_motor"
                android:textColor="@color/accent_cyan"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp"/>

            <EditText
                android:id="@+id/etTahunMotor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_tahun_motor"
                android:textColorHint="@color/text_muted"
                android:textColor="@color/text_bright"
                android:inputType="number"
                android:padding="14dp"
                android:background="@drawable/bg_input_hud"
                android:layout_marginBottom="14dp"/>

            <!-- 4. Odometer Saat Ini -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/lbl_odometer"
                android:textColor="@color/accent_cyan"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp"/>

            <EditText
                android:id="@+id/etOdometer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_odometer"
                android:textColorHint="@color/text_muted"
                android:textColor="@color/text_bright"
                android:inputType="number"
                android:padding="14dp"
                android:background="@drawable/bg_input_hud"
                android:layout_marginBottom="14dp"/>

            <!-- 5. Odometer Terakhir Ganti Oli -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/lbl_odo_oli"
                android:textColor="@color/accent_cyan"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp"/>

            <EditText
                android:id="@+id/etOdoOliTerakhir"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_odo_oli"
                android:textColorHint="@color/text_muted"
                android:textColor="@color/text_bright"
                android:inputType="number"
                android:padding="14dp"
                android:background="@drawable/bg_input_hud"
                android:layout_marginBottom="24dp"/>

            <!-- Action Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnReset"
                    android:layout_width="0dp"
                    android:layout_height="54dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:text="@string/btn_reset"
                    android:textColor="@color/text_bright"
                    app:backgroundTint="@color/accent_rose"/>

                <Button
                    android:id="@+id/btnDiagnosa"
                    android:layout_width="0dp"
                    android:layout_height="54dp"
                    android:layout_weight="2"
                    android:layout_marginStart="8dp"
                    android:text="@string/btn_diagnosa"
                    android:textColor="@color/bg_main"
                    android:textStyle="bold"
                    app:backgroundTint="@color/accent_cyan"/>
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>
</ScrollView>
